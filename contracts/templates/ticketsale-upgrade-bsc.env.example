# BSC TicketSale upgrade env
#
# Copy this file to `contracts/.env` or a dedicated local env file before
# running the upgrade and verification scripts.
#
# If the proxy already exists on BSC, you can generate a draft from live chain
# state with:
#   ./scripts/prepare-bsc-upgrade-env.sh --rpc-url "$RPC_URL" --proxy "$TICKET_SALE_PROXY" --output ./.env.upgrade.bsc
#
# Broadcast inputs for `UpgradeTicketSale.s.sol`
RPC_URL=https://your-bsc-rpc-endpoint
PRIVATE_KEY=0xyour_proxy_admin_owner_private_key
TICKET_SALE_PROXY=0x1111111111111111111111111111111111111111
PROXY_ADMIN=0x2222222222222222222222222222222222222222
NEW_IMPLEMENTATION=0x0000000000000000000000000000000000000000
PURCHASE_SIGNER=0x3333333333333333333333333333333333333333
UPGRADE_OUTPUT_FILE=./upgrade-output.json

# Optional safety assertions for `PreflightTicketSaleUpgrade.s.sol`
EXPECTED_PROXY_ADMIN=0x2222222222222222222222222222222222222222
EXPECTED_PROXY_ADMIN_OWNER=0x4444444444444444444444444444444444444444
EXPECTED_IMPLEMENTATION=0x5555555555555555555555555555555555555555
EXPECTED_DEFAULT_ADMIN=0x6666666666666666666666666666666666666666
EXPECTED_PAUSER=0x7777777777777777777777777777777777777777
EXPECTED_TREASURY=0x8888888888888888888888888888888888888888
EXPECTED_PURCHASE_SIGNER=0x9999999999999999999999999999999999999999
