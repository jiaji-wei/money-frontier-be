# TicketSale BSC mainnet deploy template.
# Copy this file outside git or to a local ignored env file before filling secrets.

CHAIN_NAME=bsc-mainnet
CHAIN_ID=56
RPC_URL=https://your-bsc-mainnet-rpc
PRIVATE_KEY=0xyour_production_deployer_private_key
DEPLOY_OUTPUT_FILE=./deploy-output.bsc-mainnet.json

# Governance and operations wallets.
# OWNER is the temporary deploy/config admin. For a one-pass deploy, set it to
# the deployer address derived from PRIVATE_KEY, then use FINAL_OWNER below.
OWNER=0xyour_deployer_wallet
FINAL_OWNER=0xyour_default_admin_or_multisig
PAUSER=0xyour_pauser_wallet
PROXY_ADMIN_OWNER=0xyour_proxy_admin_owner_or_multisig
TREASURY=0xyour_treasury_wallet

# Backend purchase intent signer address.
# The matching private key must be configured in backend PURCHASE_SIGNER_PRIVATE_KEY.
PURCHASE_SIGNER=0xyour_purchase_signer_address

# BSC mainnet payment assets.
USDT_TOKEN=0x55d398326f99059fF775485246999027B3197955
USDC_TOKEN=0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d

# Ticket price schedules use token base units.
# BSC mainnet USDT/USDC both use 18 decimals: 80 USDT/USDC = 80000000000000000000.
# 2026 sale windows, Asia/Shanghai midnight starts:
# 5/1 Early Bird, 6/1, 7/1, 7/21 Last Call.
LEVEL_1_START_TIMESTAMPS=1777564800,1780243200,1782835200,1784563200
LEVEL_1_PRICES=88000000000000000000,128000000000000000000,168000000000000000000,299000000000000000000
LEVEL_2_START_TIMESTAMPS=1777564800,1780243200,1782835200,1784563200
LEVEL_2_PRICES=398000000000000000000,498000000000000000000,698000000000000000000,1899000000000000000000
LEVEL_3_START_TIMESTAMPS=1777564800,1780243200,1782835200,1784563200
LEVEL_3_PRICES=1889000000000000000000,2889000000000000000000,3889000000000000000000,9999000000000000000000
